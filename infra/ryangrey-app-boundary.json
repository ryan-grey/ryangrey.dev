{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RuntimeServicesCeiling",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "dynamodb:*",
        "s3:*",
        "sqs:*",
        "ses:*",
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "sns:Publish",
        "lambda:InvokeFunction",
        "cloudwatch:PutMetricData",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoIamNoStsEver",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "sts:AssumeRole",
        "organizations:*",
        "account:*"
      ],
      "Resource": "*"
    }
  ]
}
